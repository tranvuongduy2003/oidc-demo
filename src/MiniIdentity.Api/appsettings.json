{
  "AccessToken": {
    "Issuer": "https://localhost:7443",
    "JwksUri": "https://localhost:7443/jwks",
    "Audience": "mini-api",
    "ClientId": "mini-spa",
    "RequiredScope": "demo.read",
    "MaxTokenBytes": 8192,
    "ClockSkewSeconds": 30,
    "JwksCacheSeconds": 300,
    "UnknownKidRefreshCooldownSeconds": 30,
    "JwksTimeoutSeconds": 3
  },
  "BrowserClientOrigin": "https://localhost:7444",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
