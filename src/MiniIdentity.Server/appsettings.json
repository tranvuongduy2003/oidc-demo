{
  "Client": {
    "Id": "mini-spa",
    "Name": "Mini React Client",
    "RedirectUri": "https://localhost:7444/callback",
    "HomeUrl": "https://localhost:7444/"
  },
  "Session": {
    "LifetimeMinutes": 30
  },
  "Provider": {
    "Issuer": "https://localhost:7443",
    "SigningKeyPath": ".keys/mini-identity-signing-key.pem"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
