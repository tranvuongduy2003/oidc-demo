<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#071713" />
    <title>@ViewData["Title"] · Mini Identity</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MiniIdentity.Server.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="authority-grid" aria-hidden="true"></div>
    <div class="ambient ambient-cyan" aria-hidden="true"></div>
    <header class="site-header">
        <a class="wordmark" asp-page="/Index" aria-label="Mini Identity home">
            <span class="wordmark-icon" aria-hidden="true">MI</span>
            <span><strong>MINI IDENTITY</strong><small>Authorization authority</small></span>
        </a>
        <span class="origin-pill"><i></i> Secure origin · :7443</span>
    </header>
    <div class="page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <span>Mini Identity Authority · OAuth 2.0 / OpenID Connect</span>
        <span class="footer-links"><a asp-page="/Privacy">Privacy</a><span aria-hidden="true">/</span><span class="footer-lock">TLS secured</span></span>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
