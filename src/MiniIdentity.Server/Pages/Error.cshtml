@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="center-stage">
    <article class="glass-card centered-card error-card">
        <div class="status-icon status-icon-danger" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 8v5m0 3h.01" /><path d="M10.3 4.6 3.5 17a2 2 0 0 0 1.8 3h13.4a2 2 0 0 0 1.8-3L13.7 4.6a2 2 0 0 0-3.4 0Z" /></svg>
        </div>
        <p class="eyebrow">Request interrupted</p>
        <h1>Something went wrong.</h1>
        <p class="lede">The identity server could not complete this request. Return home and try the flow again.</p>

        @if (Model.ShowRequestId)
        {
            <p class="request-id"><span>Request ID</span><code>@Model.RequestId</code></p>
        }

        <div class="button-row">
            <a class="button button-primary" asp-page="/Index">Return home</a>
            <a class="button button-secondary" asp-page="/Login">Try sign-in</a>
        </div>

        <details class="developer-note">
            <summary>Development details</summary>
            <p>Enable the Development environment locally to display detailed error information. Never enable it in a deployed environment because exception details can expose sensitive data.</p>
        </details>
    </article>
</section>
