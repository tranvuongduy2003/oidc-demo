@page "/login"
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<section class="auth-grid">
    <div class="glass-card auth-card">
        <div class="brand-mark compact" aria-hidden="true"><span></span><span></span></div>
        <p class="eyebrow">Mini Identity</p>
        <h1>Welcome back</h1>
        <p class="lede">Sign in on the identity server to continue securely.</p>

        <form method="post" autocomplete="on" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="form-error" role="alert">@Model.ErrorMessage</div>
            }
            <label asp-for="Input.Username">Username</label>
            <div class="input-shell">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm7 8a7 7 0 0 0-14 0" /></svg>
                <input asp-for="Input.Username" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="alice or bob" autofocus />
            </div>

            <label asp-for="Input.Password">Password</label>
            <div class="input-shell">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M7 11V8a5 5 0 0 1 10 0v3m-9 0h8a2 2 0 0 1 2 2v7H6v-7a2 2 0 0 1 2-2Z" /></svg>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
            </div>

            <button class="button button-primary button-full" type="submit">Continue securely <span aria-hidden="true">→</span></button>
        </form>
    </div>

    <aside class="glass-card context-card">
        <span class="status-dot"><i></i> Secure connection</span>
        <h2>Credentials stay here.</h2>
        <p>The React application never sees or submits your username or password.</p>
        <ul class="trust-list">
            <li><span>01</span>Passwords use PBKDF2-HMAC-SHA256</li>
            <li><span>02</span>Only a session-token hash reaches PostgreSQL</li>
            <li><span>03</span>The browser cookie is Secure and HttpOnly</li>
        </ul>
    </aside>
</section>
